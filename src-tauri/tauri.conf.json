{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Sharpener",
  "version": "0.1.0",
  "identifier": "com.caiotheodoro.promptsharpener",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "overlay",
        "title": "Prompt Sharpener",
        "width": 640,
        "height": 420,
        "resizable": true,
        "visible": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": false,
        "skipTaskbar": false,
        "shadow": true,
        "focus": true
      },
      {
        "label": "settings",
        "title": "Prompt Sharpener — Settings",
        "width": 520,
        "height": 620,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
